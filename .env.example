# Copy to .env and fill in from https://www.developer.saxo/ -> Apps
# .env is gitignored. Never commit real credentials.

# --- Application credentials (from the Saxo Developer Portal app page) ---
# The AppKey / client_id of your SIM app.
TRADER_SAXO__APP_KEY=

# The AppSecret, if your app has one. Saxo issues a secret only to confidential
# apps; public apps use PKCE and get none. Setting this switches the token
# exchange to HTTP Basic auth, which is what a confidential app requires.
TRADER_SAXO__APP_SECRET=

# Which OAuth flow to use: "auto" (default) picks "secret" when an AppSecret is
# present and "pkce" otherwise. Override only if auto-detection is wrong --
# a mismatch shows up as a bare "400 Bad Request" from the token endpoint.
TRADER_SAXO__OAUTH_FLOW=auto

# Must exactly match the "Redirect URLs" registered on the app.
# Register http://localhost:8765/callback on your SIM app to use the default.
TRADER_SAXO__REDIRECT_URI=http://localhost:8765/callback

# --- Environment selection ---
# "sim" or "live". Stays sim unless deliberately changed; see docs/live-trading.md.
TRADER_SAXO__ENVIRONMENT=sim

# --- Fast path for early testing ---
# A 24-hour token from the Developer Portal ("Get token" on the app page).
# Only valid against SIM. When set, it is used instead of the OAuth flow.
# Leave blank to use the full authorization-code + PKCE flow.
TRADER_SAXO__TOKEN_24H=

# --- Token storage ---
# Fernet key used to encrypt the persisted token file. Generated automatically
# into state/token.key (mode 0600) on first run if unset.
TRADER_TOKEN_KEY=
